<Window x:Class="SipSoftphone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="580" Height="720" MinWidth="500" MinHeight="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- accounts -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ACCOUNTS" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="AccountCombo" Height="30"
                                      SelectionChanged="OnAccountSelectionChanged"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Click="OnAddAccount"/>
                            <Button Grid.Column="2" Content="Remove" Margin="6,0,0,0" Click="OnRemoveAccount"/>
                        </Grid>
                        <TextBlock Text="Label (shown in main window)" Margin="0,8,0,0"/>
                        <TextBox x:Name="AccountLabelBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SIP -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SIP" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server"/>
                                <TextBox x:Name="SipServerBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port"/>
                                <TextBox x:Name="SipPortBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Transport"/>
                                <ComboBox x:Name="TransportCombo" Height="30" Margin="0,2,0,0">
                                    <ComboBoxItem Content="udp"/>
                                    <ComboBoxItem Content="tcp"/>
                                    <ComboBoxItem Content="tls"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username"/>
                                <TextBox x:Name="SipUserBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry (s)"/>
                                <TextBox x:Name="ExpiryBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Password" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="SipPassBox" Margin="0,2,0,8" Height="30"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoAnswerCheck" Content="Auto answer" VerticalAlignment="Center"/>
                            <CheckBox x:Name="TraceCheck" Content="SIP trace" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="TestSipButton" Content="Test connection (OPTIONS)" Click="OnTestSipClick"/>
                            <TextBlock x:Name="TestSipResult" Style="{StaticResource DimText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- HOOK -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOOK (SSE / LOG / WEBHOOK)" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <CheckBox x:Name="SseEnabledCheck" Content="SSE server enabled" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SSE port (127.0.0.1 only)"/>
                                <TextBox x:Name="SsePortBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Log file"/>
                                <TextBox x:Name="LogFileBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Webhook URL (optional)" Margin="0,8,0,0"/>
                        <TextBox x:Name="WebhookBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TRIGGER -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TRIGGER (Melipayamak auto-search)" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <CheckBox x:Name="TriggerEnabledCheck" Content="Trigger enabled" Margin="0,0,0,6"/>
                        <TextBlock Text="Fire on event"/>
                        <ComboBox x:Name="TriggerOnCombo" Margin="0,2,0,8" IsEditable="True">
                            <ComboBoxItem Content="call_answered"/>
                            <ComboBoxItem Content="call_received"/>
                            <ComboBoxItem Content="registration"/>
                            <ComboBoxItem Content="off"/>
                        </ComboBox>
                        <TextBlock Text="URL template ({phone} is replaced)"/>
                        <TextBox x:Name="TriggerUrlBox" Margin="0,2,0,8"/>
                        <TextBlock Text="Browser path (optional)"/>
                        <TextBox x:Name="BrowserPathBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- AUDIO -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="AUDIO DEVICES" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Microphone (empty = Windows default)"/>
                                <ComboBox x:Name="MicCombo" Margin="0,2,0,0" IsEditable="True"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Test mic" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                    Click="OnTestMicClick"/>
                        </Grid>
                        <TextBlock Text="Mic volume" Margin="0,8,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="MicVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" ValueChanged="OnVolumeValueChanged"/>
                            <TextBlock Grid.Column="1" x:Name="MicVolumeText" Text="100%" Style="{StaticResource DimText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Speaker (empty = Windows default)"/>
                                <ComboBox x:Name="SpeakerCombo" Margin="0,2,0,0" IsEditable="True"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Test speaker" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                    Click="OnTestSpeakerClick"/>
                        </Grid>
                        <TextBlock Text="Speaker volume" Margin="0,8,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="SpeakerVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" ValueChanged="OnVolumeValueChanged"/>
                            <TextBlock Grid.Column="1" x:Name="SpeakerVolumeText" Text="100%" Style="{StaticResource DimText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Ringtone (.wav, empty = Windows sound)" Margin="0,10,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="RingtoneBox" Margin="0,2,0,0"/>
                            <Button Grid.Column="1" Content="…" Width="34" Margin="6,2,0,0" Click="OnBrowseRingtone"/>
                            <Button Grid.Column="2" Content="▶" Width="34" Margin="6,2,0,0" Click="OnTestRingtone"
                                    ToolTip="Preview ringtone"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveHint" Grid.Column="0" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Cancel" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource BigGreenButton}" Click="OnSave"/>
        </Grid>
    </Grid>
</Window>

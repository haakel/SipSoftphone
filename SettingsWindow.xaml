<Window x:Class="SipSoftphone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="640" MinWidth="480" MinHeight="480"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SIP" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="Server"/>
                        <TextBox x:Name="SipServerBox" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username"/>
                                <TextBox x:Name="SipUserBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port"/>
                                <TextBox x:Name="SipPortBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Password" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="SipPassBox" Margin="0,2,0,8" Height="30"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Expiry (seconds)"/>
                                <TextBox x:Name="ExpiryBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <CheckBox x:Name="AutoAnswerCheck" Content="Auto answer"/>
                                <CheckBox x:Name="TraceCheck" Content="SIP trace logging" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOOK (SSE / LOG / WEBHOOK)" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <CheckBox x:Name="SseEnabledCheck" Content="SSE server enabled" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SSE port (127.0.0.1 only)"/>
                                <TextBox x:Name="SsePortBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Log file"/>
                                <TextBox x:Name="LogFileBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Webhook URL (optional)" Margin="0,8,0,0"/>
                        <TextBox x:Name="WebhookBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TRIGGER (Melipayamak auto-search)" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <CheckBox x:Name="TriggerEnabledCheck" Content="Trigger enabled" Margin="0,0,0,6"/>
                        <TextBlock Text="Fire on event"/>
                        <ComboBox x:Name="TriggerOnCombo" Margin="0,2,0,8" IsEditable="True">
                            <ComboBoxItem Content="call_answered"/>
                            <ComboBoxItem Content="call_received"/>
                            <ComboBoxItem Content="registration"/>
                            <ComboBoxItem Content="off"/>
                        </ComboBox>
                        <TextBlock Text="URL template ({phone} is replaced)"/>
                        <TextBox x:Name="TriggerUrlBox" Margin="0,2,0,8"/>
                        <TextBlock Text="Browser path (optional)"/>
                        <TextBox x:Name="BrowserPathBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="AUDIO DEVICES" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="Microphone (empty = Windows default)"/>
                        <ComboBox x:Name="MicCombo" Margin="0,2,0,8" IsEditable="True"/>
                        <TextBlock Text="Speaker (empty = Windows default)"/>
                        <ComboBox x:Name="SpeakerCombo" Margin="0,2,0,0" IsEditable="True"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveHint" Grid.Column="0" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Cancel" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource BigGreenButton}" Click="OnSave"/>
        </Grid>
    </Grid>
</Window>

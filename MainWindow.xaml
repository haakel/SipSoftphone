<Window x:Class="SipSoftphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SipSoftphone"
        Title="SipSoftphone" Width="1120" Height="760" MinWidth="960" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnWindowPreviewKeyDown" StateChanged="OnWindowStateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:KeyToBrushConverter x:Key="KeyToBrush"/>
        <local:NullToVisConverter x:Key="NullToVis"/>

        <Style x:Key="CallPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CallStateKey}" Value="Ringing">
                    <Setter Property="Background" Value="#3A2B05"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CallStateKey}" Value="Active">
                    <Setter Property="Background" Value="#0F2A15"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CallStateKey}" Value="Ended">
                    <Setter Property="Background" Value="#2A1215"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PadKeyButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#253048"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= header ================= -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0"
                             Fill="{Binding RegDotBrushKey, Converter={StaticResource KeyToBrush}}"/>
                    <TextBlock Text="{Binding RegText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RegExpiryText}" Style="{StaticResource DimText}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ComboBox Width="190" VerticalAlignment="Center" Margin="0,0,6,0"
                              ItemsSource="{Binding Accounts}"
                              SelectedIndex="{Binding SelectedAccountIndex, Mode=TwoWay}"
                              ToolTip="Active SIP account"/>
                    <Button Content="Reg" Command="{Binding RegisterCommand}" Padding="10,5" ToolTip="Re-register"/>
                    <Button Content="Unreg" Command="{Binding UnregisterCommand}" Padding="10,5" Margin="4,0,0,0"
                            ToolTip="Unregister manually"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding ServerInfoText}" Style="{StaticResource DimText}"
                           VerticalAlignment="Center" Margin="18,0"/>

                <Button Grid.Column="3" Content="AB ⇄" Padding="10,5" Click="OnRtlClick"
                        ToolTip="Toggle RTL / LTR layout"/>

                <Button Grid.Column="4" Content="⚙ Settings" Margin="8,0,0,0" Click="OnSettingsClick"/>
            </Grid>
        </Border>

        <!-- ================= call panel ================= -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CallPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="CALL" Style="{StaticResource DimText}" FontSize="11"/>
                    <TextBlock Text="{Binding DisplayNameText}" FontSize="30" FontWeight="Bold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NormalizedText}" Style="{StaticResource DimText}"
                               FontSize="16" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding RawNumberText}" Style="{StaticResource DimText}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- ringing pulse ring -->
                    <Ellipse Width="86" Height="86" Stroke="{StaticResource WarnBrush}" StrokeThickness="2"
                             Opacity="0" HorizontalAlignment="Center"
                             Visibility="{Binding IsRinging, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ringPulseBegin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.9" To="0.15" Duration="0:0:0.7"
                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                     From="70" To="100" Duration="0:0:0.7"
                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                     From="70" To="100" Duration="0:0:0.7"
                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Margin="0,-86,0,0">
                        <TextBlock Text="{Binding StateText}" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource DimText}"
                                   FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontFamily="Consolas"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                    Visibility="{Binding CodecText, Converter={StaticResource NullToVis}}">
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="8,2">
                                <TextBlock Text="{Binding CodecText}" Style="{StaticResource DimText}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Answer" Style="{StaticResource BigGreenButton}"
                            Margin="0,0,6,0" Command="{Binding AnswerCommand}"/>
                    <Button Grid.Column="1" Content="Reject" Style="{StaticResource BigButton}"
                            Margin="3,0" Command="{Binding RejectCommand}"/>
                    <Button Grid.Column="2" Content="Hangup" Style="{StaticResource BigRedButton}"
                            Margin="6,0,0,0" Command="{Binding HangupCommand}"/>
                </Grid>

                <!-- in-call controls -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource ToggleButton}"
                                  IsChecked="{Binding MuteChecked, Mode=OneWay}"
                                  Command="{Binding ToggleMuteCommand}"
                                  Margin="0,0,6,0">
                        <TextBlock Text="{Binding MuteLabel}"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleButton}"
                                  IsChecked="{Binding HoldChecked, Mode=OneWay}"
                                  Command="{Binding ToggleHoldCommand}"
                                  Margin="3,0">
                        <TextBlock Text="{Binding HoldLabel}"/>
                    </ToggleButton>
                    <Button Grid.Column="2" Content="Transfer" Margin="6,0,0,0"
                            Command="{Binding ToggleTransferPanelCommand}"/>
                </Grid>

                <!-- transfer panel -->
                <Border Grid.Row="4" Margin="0,10,0,0" Padding="10,8"
                        Background="{StaticResource PanelAltBrush}" CornerRadius="8"
                        Visibility="{Binding TransferPanelOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TransferText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" VerticalContentAlignment="Center"
                                     ToolTip="Transfer target (extension or number)"/>
                            <Button Grid.Column="1" Content="Blind" Style="{StaticResource BigGreenButton}"
                                    Padding="16,8" Command="{Binding TransferConfirmCommand}"/>
                            <Button Grid.Column="2" Content="✕" Margin="6,0,0,0" Padding="10,8"
                                    Command="{Binding ToggleTransferPanelCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding TransferStatus}" Style="{StaticResource DimText}"
                                   FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= dial + contacts ================= -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- speed dials -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding SpeedDials}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,4,4" Padding="8,4"
                                    Command="{Binding DataContext.DialContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Phone}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1" Text="OUTGOING" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,6"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="DialBox" FontSize="18" Height="40"
                             Text="{Binding DialText, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" KeyDown="OnDialKeyDown"/>
                    <Button Grid.Column="1" Content="Call" Style="{StaticResource BigGreenButton}"
                            Padding="18,8" Margin="8,0,0,0" Command="{Binding CallCommand}"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding DialNormText}" Style="{StaticResource DimText}"
                           FontSize="11" Margin="0,44,0,0" HorizontalAlignment="Left"/>

                <!-- dial pad -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,8,0,0" VerticalAlignment="Top">
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="1">
                        <StackPanel><TextBlock Text="1" FontSize="18"/><TextBlock Text=" " Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="2">
                        <StackPanel><TextBlock Text="2" FontSize="18"/><TextBlock Text="ABC" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="3">
                        <StackPanel><TextBlock Text="3" FontSize="18"/><TextBlock Text="DEF" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="4">
                        <StackPanel><TextBlock Text="4" FontSize="18"/><TextBlock Text="GHI" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="5">
                        <StackPanel><TextBlock Text="5" FontSize="18"/><TextBlock Text="JKL" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="6">
                        <StackPanel><TextBlock Text="6" FontSize="18"/><TextBlock Text="MNO" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="7">
                        <StackPanel><TextBlock Text="7" FontSize="18"/><TextBlock Text="PQRS" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="8">
                        <StackPanel><TextBlock Text="8" FontSize="18"/><TextBlock Text="TUV" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="9">
                        <StackPanel><TextBlock Text="9" FontSize="18"/><TextBlock Text="WXYZ" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="*">
                        <TextBlock Text="*" FontSize="18"/>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="0">
                        <StackPanel><TextBlock Text="0" FontSize="18"/><TextBlock Text="+" Style="{StaticResource PadLetter}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="#">
                        <TextBlock Text="#" FontSize="18"/>
                    </Button>
                </UniformGrid>

                <!-- contacts -->
                <Grid Grid.Row="4" Margin="0,10,0,0" Height="150">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CONTACTS" Style="{StaticResource DimText}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ContactSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26" Padding="6,3" FontSize="12" VerticalContentAlignment="Center"/>
                        <ToggleButton Grid.Column="2" x:Name="AddContactToggle" Padding="8,3" Margin="6,0,0,0"
                                      ToolTip="Add contact">
                            <TextBlock Text="＋" FontSize="12"/>
                        </ToggleButton>
                        <Button Grid.Column="3" Content="－" Padding="8,3" Margin="4,0,0,0"
                                Command="{Binding RemoveContactCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=ContactsList}"
                                ToolTip="Remove selected"/>
                    </Grid>
                    <!-- add contact inline form -->
                    <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="8,6"
                            Visibility="{Binding IsChecked, ElementName=AddContactToggle, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="110" Height="26" Padding="6,3" FontSize="12"
                                         Text="{Binding NewContactName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Name"/>
                                <TextBox Width="110" Height="26" Padding="6,3" FontSize="12" Margin="6,0,0,0"
                                         Text="{Binding NewContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Phone"/>
                                <CheckBox Content="★" Margin="8,0,4,0" VerticalAlignment="Center"
                                          IsChecked="{Binding NewContactSpeedDial}"
                                          ToolTip="Speed dial"/>
                                <Button Content="Add" Padding="12,3" Command="{Binding AddContactCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ContactsList" ItemsSource="{Binding FilteredContacts}"
                             SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                             Style="{StaticResource LogListBox}"
                             ItemContainerStyle="{StaticResource ContactItem}"
                             MouseDoubleClick="OnContactDoubleClick"
                             ToolTip="Double-click to dial">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock Text="{Binding Phone}" Style="{StaticResource DimText}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="★" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource WarnBrush}"
                                               Visibility="{Binding SpeedDial, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= history ================= -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CALL HISTORY" Style="{StaticResource DimText}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="All" GroupName="hf"
                                     IsChecked="True" Command="{Binding HistoryFilterCommand}" CommandParameter="All" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Missed" GroupName="hf"
                                     Command="{Binding HistoryFilterCommand}" CommandParameter="Missed" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Incoming" GroupName="hf"
                                     Command="{Binding HistoryFilterCommand}" CommandParameter="Incoming" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Outgoing" GroupName="hf"
                                     Command="{Binding HistoryFilterCommand}" CommandParameter="Outgoing" FontSize="11"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="160" Height="26" Padding="6,3" FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search history"/>
                </Grid>
                <ListView Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding HistoryView}" MouseDoubleClick="OnHistoryDoubleClick"
                          ToolTip="Double-click a row to redial">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="26" DisplayMemberBinding="{Binding DirectionIcon}"/>
                            <GridViewColumn Header="Time" Width="120" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Number" Width="110" DisplayMemberBinding="{Binding Display}"/>
                            <GridViewColumn Header="Event" Width="130" DisplayMemberBinding="{Binding Event}"/>
                            <GridViewColumn Header="Detail" Width="200" DisplayMemberBinding="{Binding Detail}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- ================= log ================= -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LOG" Style="{StaticResource DimText}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="All" GroupName="lf"
                                     IsChecked="True" Command="{Binding LogFilterCommand}" CommandParameter="All" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Calls" GroupName="lf"
                                     Command="{Binding LogFilterCommand}" CommandParameter="Calls" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="SIP" GroupName="lf"
                                     Command="{Binding LogFilterCommand}" CommandParameter="SIP" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Audio" GroupName="lf"
                                     Command="{Binding LogFilterCommand}" CommandParameter="Audio" FontSize="11"/>
                        <RadioButton Style="{StaticResource ChipButton}" Content="Errors" GroupName="lf"
                                     Command="{Binding LogFilterCommand}" CommandParameter="Errors" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource ToggleButton}" Padding="8,3" FontSize="11"
                                      IsChecked="{Binding LogPaused, Mode=TwoWay}"
                                      Command="{Binding ToggleLogPauseCommand}"
                                      ToolTip="Pause log updates">
                            <TextBlock Text="⏸" FontSize="11"/>
                        </ToggleButton>
                        <Button Content="Copy" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Command="{Binding CopyLogCommand}"/>
                        <Button Content="Clear" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Command="{Binding ClearLogCommand}"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogItemsView}"
                         Style="{StaticResource LogListBox}" ItemContainerStyle="{StaticResource LogItem}"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{Binding Brush}" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>

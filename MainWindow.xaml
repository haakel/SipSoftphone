<Window x:Class="SipSoftphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SipSoftphone"
        Title="SipSoftphone" Width="400" Height="780" MinWidth="360" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnWindowPreviewKeyDown" StateChanged="OnWindowStateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:KeyToBrushConverter x:Key="KeyToBrush"/>
        <local:NullToVisConverter x:Key="NullToVis"/>

        <!-- Phone frame style -->
        <Style x:Key="PhoneFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active tab indicator -->
        <Style x:Key="ActiveTabIndicator" TargetType="Border">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- Page container -->
        <Style x:Key="PageContainer" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Status bar style -->
        <Style x:Key="StatusBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Phone frame containing all content -->
        <Border Style="{StaticResource PhoneFrameStyle}">
            
            <!-- ================= CALLS PAGE ================= -->
            <Grid x:Name="CallsPage" Visibility="{Binding IsCallsPageVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status bar (registration + account) -->
                <Border Grid.Row="0" Style="{StaticResource StatusBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding RegDotBrushKey, Converter={StaticResource KeyToBrush}}"/>
                            <TextBlock Text="{Binding RegText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="200" ItemsSource="{Binding Accounts}"
                                  SelectedIndex="{Binding SelectedAccountIndex, Mode=TwoWay}"
                                  ToolTip="Active SIP account"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="⚙" Padding="4,4" Margin="8,0,0,0" Click="OnSettingsClick" ToolTip="Settings"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Current call display -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Call status header -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="CALL" Style="{StaticResource DimText}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StateText}" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Caller info or dial pad trigger -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="80" Height="80" Background="{StaticResource AccentBrush}" CornerRadius="40"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                                <Setter Property="Opacity" Value="0.3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard x:Name="ringPulseBegin">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.3" To="0.05" Duration="0:0:0.8"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                                <TextBlock Text="📞" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Ellipse>
                            <TextBlock Text="{Binding DisplayNameText}" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NormalizedText}" Style="{StaticResource DimText}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DurationText}" FontFamily="Consolas" FontSize="18"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding DurationText, Converter={StaticResource NullToVis}, FallbackValue='Visible'}"/>
                        </StackPanel>

                        <!-- In-call controls -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔇" Command="{Binding ToggleMuteCommand}"
                                        Style="{StaticResource TabButton}" Margin="0,0,5,0"
                                        ToolTip="Mute"/>
                                <Button Grid.Column="1" Content="🔊" Command="{Binding HoldCommand}"
                                        Style="{StaticResource TabButton}" Margin="0,0,5,0"
                                        ToolTip="Hold"/>
                                <Button Grid.Column="2" Content="➕" Command="{Binding ToggleTransferPanelCommand}"
                                        Style="{StaticResource TabButton}"
                                        ToolTip="Transfer"/>
                            </Grid>
                            
                            <!-- Transfer panel -->
                            <Border Margin="0,10,0,0" Padding="12,8" Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="12"
                                    Visibility="{Binding TransferPanelOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBox Text="{Binding TransferText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="10,6" FontSize="14"
                                             HorizontalContentAlignment="Center"
                                             ToolTip="Transfer target"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Button Content="Blind" Command="{Binding TransferConfirmCommand}"
                                                Style="{StaticResource BigGreenButton}" Width="80" Margin="0,0,6,0"/>
                                        <Button Content="✕" Command="{Binding ToggleTransferPanelCommand}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Answer/Reject buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Content="Answer" Style="{StaticResource BigGreenButton}" Width="100" Margin="0,0,10,0"
                                    Command="{Binding AnswerCommand}"
                                    Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Reject" Style="{StaticResource BigRedButton}" Width="100"
                                    Command="{Binding RejectCommand}"
                                    Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="End Call" Style="{StaticResource BigRedButton}" Width="100"
                                    Command="{Binding HangupCommand}"
                                    Visibility="{Binding IsCallActive, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dial pad section -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
                    <StackPanel>
                        <!-- Dial input -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="DialBox" FontSize="20" Height="44"
                                     Text="{Binding DialText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center" KeyDown="OnDialKeyDown"
                                     Background="Transparent" Foreground="{StaticResource TextBrush}"/>
                            <Button Grid.Column="1" Content="📞" Style="{StaticResource BigGreenButton}"
                                    Padding="14,10" Margin="8,0,0,0" Command="{Binding CallCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding DialNormText}" Style="{StaticResource DimText}"
                                   FontSize="11" Margin="0,0,0,12" HorizontalAlignment="Right"/>

                        <!-- Keypad -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="1">
                                <StackPanel><TextBlock Text="1" FontSize="22"/><TextBlock Text=" " Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="2">
                                <StackPanel><TextBlock Text="2" FontSize="22"/><TextBlock Text="ABC" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="3">
                                <StackPanel><TextBlock Text="3" FontSize="22"/><TextBlock Text="DEF" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="4">
                                <StackPanel><TextBlock Text="4" FontSize="22"/><TextBlock Text="GHI" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="5">
                                <StackPanel><TextBlock Text="5" FontSize="22"/><TextBlock Text="JKL" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="6">
                                <StackPanel><TextBlock Text="6" FontSize="22"/><TextBlock Text="MNO" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="7">
                                <StackPanel><TextBlock Text="7" FontSize="22"/><TextBlock Text="PQRS" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="8">
                                <StackPanel><TextBlock Text="8" FontSize="22"/><TextBlock Text="TUV" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="9">
                                <StackPanel><TextBlock Text="9" FontSize="22"/><TextBlock Text="WXYZ" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="*">
                                <TextBlock Text="*" FontSize="22"/>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="0">
                                <StackPanel><TextBlock Text="0" FontSize="22"/><TextBlock Text="+" Style="{StaticResource PadLetter}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PadKeyButton}" Command="{Binding PadCommand}" CommandParameter="#">
                                <TextBlock Text="#" FontSize="22"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= CONTACTS PAGE ================= -->
            <Grid x:Name="ContactsPage" Visibility="{Binding IsContactsPageVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search + Add -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ContactSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="12,8" FontSize="14"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Search contacts"/>
                            <Button Grid.Column="1" Content="＋" Padding="12,8" Margin="8,0,0,0" FontSize="18"
                                    Command="{Binding AddContactCommand}" ToolTip="Add contact"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Contacts list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,80">
                        <!-- Speed dials -->
                        <ItemsControl ItemsSource="{Binding SpeedDials}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="4" Padding="12,8" Width="120"
                                            Command="{Binding DataContext.DialContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Phone}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="20">
                                                <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarText}" FontSize="14"/>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ALL CONTACTS" Style="{StaticResource DimText}" FontSize="11" Margin="16,12,16,8"/>

                        <!-- Full contacts list -->
                        <ListBox ItemsSource="{Binding FilteredContacts}"
                                 SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                                 MouseDoubleClick="OnContactDoubleClick"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="44" Height="44" Background="{StaticResource AccentBrush}" CornerRadius="22" Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarText}" FontSize="14"/>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Phone}" Style="{StaticResource DimText}" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="★" FontSize="14" Foreground="{StaticResource WarnBrush}"
                                                       Visibility="{Binding SpeedDial, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= LOGS PAGE ================= -->
            <Grid x:Name="LogsPage" Visibility="{Binding IsLogsPageVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log type selector -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,8,0">
                                <TextBlock Text="History" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,8,0">
                                <TextBlock Text="Logs" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <!-- History filters -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ChipButton}" Content="All" GroupName="hf"
                                         IsChecked="True" Command="{Binding HistoryFilterCommand}" CommandParameter="All" FontSize="11"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="Missed" GroupName="hf"
                                         Command="{Binding HistoryFilterCommand}" CommandParameter="Missed" FontSize="11"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="In" GroupName="hf"
                                         Command="{Binding HistoryFilterCommand}" CommandParameter="Incoming" FontSize="11"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="Out" GroupName="hf"
                                         Command="{Binding HistoryFilterCommand}" CommandParameter="Outgoing" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- History list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding HistoryView}" MouseDoubleClick="OnHistoryDoubleClick"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="30" Height="30" 
                                                 Fill="{Binding DirectionIcon, Converter={StaticResource KeyToBrush}}" CornerRadius="15"
                                                 Grid.Column="0" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource DimText}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Event}" Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" MaxWidth="80"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- ================= CALL HISTORY / LOGS SEPARATE ================= -->
            <Grid x:Name="HistoryPage" Visibility="{Binding IsHistoryPageVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search + Controls -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="12,8" FontSize="14" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="🗑" Padding="12,8" Margin="8,0,0,0"
                                Command="{Binding ClearHistoryCommand}" ToolTip="Clear history"/>
                    </Grid>
                </Border>

                <!-- History list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding HistoryView}" MouseDoubleClick="OnHistoryDoubleClick"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="36" Height="36" 
                                                 Fill="{Binding DirectionIcon, Converter={StaticResource KeyToBrush}}" CornerRadius="18"
                                                 Grid.Column="0" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource DimText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Event}" Style="{StaticResource DimText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- ================= SYSTEM LOGS ================= -->
            <Grid x:Name="SystemLogsPage" Visibility="{Binding IsSystemLogsPageVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log controls -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="LOG" Style="{StaticResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="All" GroupName="lf"
                                         IsChecked="True" Command="{Binding LogFilterCommand}" CommandParameter="All" FontSize="11" Margin="8,0,0,0"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="Calls" GroupName="lf"
                                         Command="{Binding LogFilterCommand}" CommandParameter="Calls" FontSize="11"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="SIP" GroupName="lf"
                                         Command="{Binding LogFilterCommand}" CommandParameter="SIP" FontSize="11"/>
                            <RadioButton Style="{StaticResource ChipButton}" Content="Errors" GroupName="lf"
                                         Command="{Binding LogFilterCommand}" CommandParameter="Errors" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToggleButton}" Padding="10,6" FontSize="11"
                                          IsChecked="{Binding LogPaused, Mode=TwoWay}"
                                          Command="{Binding ToggleLogPauseCommand}"
                                          ToolTip="Pause log">
                                <TextBlock Text="⏸" FontSize="11"/>
                            </ToggleButton>
                            <Button Content="Copy" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                    Command="{Binding CopyLogCommand}"/>
                            <Button Content="Clear" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                    Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding LogItemsView}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="10"
                                               Foreground="{Binding Brush}" TextWrapping="WrapWithOverflow"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

        </Border>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="20,20,0,0" Padding="16,12" Margin="0,-12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Calls Tab -->
                <Button Grid.Column="0" Content="📞" Style="{StaticResource TabButton}"
                        Command="{Binding SetCallsPageCommand}"
                        ToolTip="Calls &amp; Dial"/>
                
                <!-- Contacts Tab -->
                <Button Grid.Column="1" Content=" contacts" Style="{StaticResource TabButton}"
                        Command="{Binding SetContactsPageCommand}"
                        ToolTip="Contacts"/>
                
                <!-- History Tab -->
                <Button Grid.Column="2" Content="📋 history" Style="{StaticResource TabButton}"
                        Command="{Binding SetHistoryPageCommand}"
                        ToolTip="Call History"/>
                
                <!-- Logs Tab -->
                <Button Grid.Column="3" Content="📝 logs" Style="{StaticResource TabButton}"
                        Command="{Binding SetSystemLogsPageCommand}"
                        ToolTip="System Logs"/>
            </Grid>
        </Border>

        <!-- Indicator dots for active page -->
        <Canvas Grid.Row="1" Height="6" VerticalAlignment="Top" Canvas.Top="-8" HorizontalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Canvas.Left="0" Opacity="1"/>

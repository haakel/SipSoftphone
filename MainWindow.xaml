<Window x:Class="SipSoftphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SipSoftphone" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- header: registration -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RegDot" Width="12" Height="12" Fill="{StaticResource TextDimBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="RegText" Text="Offline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ServerInfoText" Grid.Column="1" Style="{StaticResource DimText}"
                           VerticalAlignment="Center" Margin="18,0"/>
                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙ Settings" Click="OnSettingsClick"/>
            </Grid>
        </Border>

        <!-- caller panel -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="20" Margin="0,0,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="CALL" Style="{StaticResource DimText}" FontSize="11"/>
                    <TextBlock x:Name="DisplayNameText" Text="—" FontSize="30" FontWeight="Bold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NormalizedText" Text="" Style="{StaticResource DimText}"
                               FontSize="16" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RawNumberText" Text="" Style="{StaticResource DimText}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="Idle" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DurationText" Text="" Style="{StaticResource DimText}"
                               FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"
                               FontFamily="Consolas"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AnswerButton" Grid.Column="0" Content="Answer"
                            Style="{StaticResource BigGreenButton}"
                            Margin="0,0,6,0" IsEnabled="False" Click="OnAnswerClick"/>
                    <Button x:Name="RejectButton" Grid.Column="1" Content="Reject"
                            Style="{StaticResource BigButton}" Margin="3,0"
                            IsEnabled="False" Click="OnRejectClick"/>
                    <Button x:Name="HangupButton" Grid.Column="2" Content="Hangup"
                            Style="{StaticResource BigRedButton}"
                            Margin="6,0,0,0" IsEnabled="False" Click="OnHangupClick"/>
                </Grid>
            </Grid>
        </Border>

        <!-- dial pad -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="OUTGOING" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,8"/>

                <TextBox x:Name="DialBox" Grid.Row="1" FontSize="18" Height="42"
                         HorizontalContentAlignment="Center" KeyDown="OnDialKeyDown"
                         TextChanged="OnDialTextChanged"/>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0" VerticalAlignment="Top">
                    <Button Content="1" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="2" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="3" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="4" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="5" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="6" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="7" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="8" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="9" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="*" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="0" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                    <Button Content="#" Style="{StaticResource PadButton}" Click="OnPadClick"/>
                </UniformGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DialNormText" Grid.Column="0" Style="{StaticResource DimText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CallButton" Grid.Column="1" Content="Call"
                            Style="{StaticResource BigGreenButton}"
                            Click="OnCallClick"/>
                </Grid>
            </Grid>
        </Border>

        <!-- history -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CALL HISTORY" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,6"/>
                <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Dir" Width="40" DisplayMemberBinding="{Binding Direction}"/>
                            <GridViewColumn Header="Number" Width="130" DisplayMemberBinding="{Binding Phone}"/>
                            <GridViewColumn Header="Event" Width="120" DisplayMemberBinding="{Binding Event}"/>
                            <GridViewColumn Header="Detail" Width="220" DisplayMemberBinding="{Binding Detail}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- log -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="STATUS / LOG" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource MultilineTextBox}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="{StaticResource PanelAltBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
